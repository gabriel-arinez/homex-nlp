# La biblioteca no lee este archivo. Django/CLI construirá RuntimeSettings y le
# pasará un mapping explícito. Las rutas son absolutas.
HOMEX_NLP_MODE=RULES_ONLY
# HOMEX_NER_MODEL_PATH=/opt/homex/models/ner-v1
# HOMEX_NER_MODEL_SHA256=<64 caracteres hexadecimales>
# HOMEX_DOMAIN_PROFILE_VERSION=<versión entregada por HOMEX>
# HOMEX_ASR_MODEL_PATH=/opt/homex/models/faster-whisper-small
HOMEX_ASR_DEVICE=cpu
HOMEX_ASR_COMPUTE_TYPE=int8
HOMEX_ASR_CPU_THREADS=2
