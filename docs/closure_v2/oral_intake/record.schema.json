{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^ORAL-[A-Z0-9-]+$",
      "title": "Id",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Text Sha256",
      "type": "string"
    },
    "origin": {
      "enum": [
        "SINTETICO_ORAL",
        "ASR_REAL",
        "TRANSCRIPCION_HUMANA"
      ],
      "title": "Origin",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "external_test",
        "quarantine"
      ],
      "title": "Split",
      "type": "string"
    },
    "source_case_id": {
      "minLength": 1,
      "title": "Source Case Id",
      "type": "string"
    },
    "paraphrase_group_id": {
      "minLength": 1,
      "title": "Paraphrase Group Id",
      "type": "string"
    },
    "template_id": {
      "minLength": 1,
      "title": "Template Id",
      "type": "string"
    },
    "parent_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Record Id"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "speaker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speaker Id"
    },
    "audio_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Audio Sha256"
    },
    "authorization_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Ref"
    },
    "retention_policy_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retention Policy Ref"
    },
    "privacy_review_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Privacy Review Ref"
    },
    "human_review_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Human Review Ref"
    },
    "human_transcription_from_audio": {
      "title": "Human Transcription From Audio",
      "type": "boolean"
    },
    "entities": {
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Entities",
      "type": "array"
    },
    "phenomena": {
      "items": {
        "enum": [
          "direct",
          "quantity",
          "capacity",
          "internal_quantity",
          "negation",
          "correction",
          "ellipsis",
          "missing",
          "noise",
          "price",
          "multiple_products"
        ],
        "type": "string"
      },
      "title": "Phenomena",
      "type": "array"
    }
  },
  "required": [
    "id",
    "text",
    "text_sha256",
    "origin",
    "split",
    "source_case_id",
    "paraphrase_group_id",
    "template_id",
    "parent_record_id",
    "session_id",
    "speaker_id",
    "audio_sha256",
    "authorization_ref",
    "retention_policy_ref",
    "privacy_review_ref",
    "human_review_ref",
    "human_transcription_from_audio",
    "entities",
    "phenomena"
  ],
  "title": "OralRecord",
  "type": "object"
}
